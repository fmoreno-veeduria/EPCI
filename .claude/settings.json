{
  "permissions": {
    "deny": [
      "Edit(/mysql/**)",
      "Edit(/etl/**)",
      "Edit(/cargador/**)",
      "Edit(/web/server/**)",
      "Edit(/web/src/surveyData.ts)",
      "Edit(/web/src/types.ts)",
      "Edit(/web/src/components/EditarValores.tsx)",
      "Edit(/web/src/components/GestionAnios.tsx)",
      "Edit(/docker-compose.yml)",
      "Edit(/DESPLIEGUE_CAMBIOS_BD.md)",
      "Edit(/CLAUDE.md)",
      "Edit(/.claude/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|NotebookEdit|mcp__terminal__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/proteger_datos.py\""
          }
        ]
      }
    ]
  }
}
